{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metrics-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "6b31b2bc150042f7a1e225596eeaf733",
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1000",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ]
}
